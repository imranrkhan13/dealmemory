# ==============================================================================
# DealMemory Environment Configuration
# ==============================================================================

# Core Database Connection (PostgreSQL 14+)
# Example for local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dealmemory?schema=public"

# NextAuth Configuration
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SDK Cross-Origin Resource Sharing (CORS)
# Comma-separated list of origins permitted to stream events from client browsers
SDK_CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://app.example.com"

# Dodo Payments (Subscription & Billing)
# Sign up at https://app.dodopayments.com (test mode active by default)
DODO_ENVIRONMENT="test_mode"
DODO_API_KEY=""
DODO_WEBHOOK_SECRET=""
DODO_PRODUCT_ID=""
DODO_PRICE_ID=""

# Supermemory AI Integration (Customer context & vector memory graph)
SUPERMEMORY_API_KEY=""
SUPERMEMORY_BASE_URL="https://api.supermemory.ai"
