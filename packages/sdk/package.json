{
  "name": "dealmemory",
  "version": "0.1.0",
  "description": "Privacy-safe product memory & event tracking. npm install, one DEALMEMORY_API_KEY in .env, done — no other setup.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dealmemory": "./bin/dealmemory.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js",
      "default": "./dist/auto.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "sideEffects": [
    "./dist/auto.js",
    "./dist/index.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "postinstall": "node ./bin/dealmemory.mjs hint"
  },
  "keywords": [
    "dealmemory",
    "activation",
    "analytics",
    "saas",
    "sdk",
    "journeys",
    "product-memory"
  ],
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
