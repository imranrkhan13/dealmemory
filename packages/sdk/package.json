  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "keywords": ["activation", "analytics", "saas", "sdk", "journeys"],
  "devDependencies": { "typescript": "^5.7.2" },
  "engines": { "node": ">=18" }
